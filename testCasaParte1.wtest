import casa.*
describe "casa de pepe y julian" {
    method initialize() {
        cuentaDeGastosDeMantenimiento.costoDeOperacion(20)
    }

    test "Cuenta corriente sin gastos iniciales" {
        cuentaCorriente.depositar(300)
        assert.equals(0, casa.montoTotalDeGastos())
    }

    test "Gasto de 200 impacta saldo y gastos" {
        cuentaCorriente.depositar(300)
        casa.gasto(200)
        assert.equals(100, cuentaCorriente.saldo())
        assert.equals(200, casa.montoTotalDeGastos())
    }

    test "Gasto que deja saldo en negativo" {
        cuentaCorriente.depositar(300)
        casa.gasto(400)
        assert.equals(-100, cuentaCorriente.saldo())
        assert.equals(400, casa.montoTotalDeGastos())
    }

    test "Cambio de mes resetea gastos a cero" {
        casa.gasto(600)
        casa.cambioDeMes()
        assert.equals(0, casa.montoTotalDeGastos())
    }

    test "Depositar 100 disminuye en costoOperacion 20" {
        cuentaDeGastosDeMantenimiento.depositar(1000)
        assert.equals(980, cuentaDeGastosDeMantenimiento.saldo())
    }

    test "Extracciones sucesivas modifican saldo correctamente" {
        cuentaDeGastosDeMantenimiento.depositar(1000)
        cuentaDeGastosDeMantenimiento.extraer(580)
        assert.equals(400, cuentaDeGastosDeMantenimiento.saldo())
        cuentaDeGastosDeMantenimiento.extraer(500)
        assert.equals(-100, cuentaDeGastosDeMantenimiento.saldo())
    }

    test "Depositar luego de saldo negativo ajusta saldo correctamente" {
        cuentaDeGastosDeMantenimiento.depositar(150)
        assert.equals(30, cuentaDeGastosDeMantenimiento.saldo())
    }

    test "Depositar monto pequeño lanza excepción" {
        assert.throwsException({
            cuentaDeGastosDeMantenimiento.depositar(10)
        })
    }

    test "Saldo combinado con depósitos positivos" {
        cuentaDeGastosDeMantenimiento.costoDeOperacion(0)
        cuentaCorriente.depositar(200)
        cuentaDeGastosDeMantenimiento.depositar(50)
        assert.equals(250, cuentaCombinada.saldo())
    }

    test "Saldo combinado con saldo negativo en cuenta corriente" {
        cuentaDeGastosDeMantenimiento.costoDeOperacion(0)
        cuentaCorriente.depositar(-50)
        cuentaDeGastosDeMantenimiento.depositar(200)
        assert.equals(200, cuentaCombinada.saldo())
    }

    test "Saldo combinado con saldo negativo en cuenta de gastos" {
        cuentaDeGastosDeMantenimiento.costoDeOperacion(0)
        cuentaCorriente.depositar(150)
        cuentaDeGastosDeMantenimiento.depositar(-20)
        assert.equals(150, cuentaCombinada.saldo())
    }

    test "Saldo combinado con saldos negativos en ambas cuentas" {
        cuentaCorriente.depositar(-40)
        cuentaDeGastosDeMantenimiento.depositar(-60)
        assert.equals(0, cuentaCombinada.saldo())
    }

    test "Saldo inicial en cuenta de gastos y combinada" {
        casa.cambiarCuenta(cuentaCombinada)
        cuentaDeGastosDeMantenimiento.costoDeOperacion(20)
        assert.equals(0, cuentaDeGastosDeMantenimiento.saldo())
    }

    test "Depositar dinero en ambas cuentas afecta saldo combinado" {
        cuentaCorriente.depositar(300)
        cuentaCombinada.depositar(100)
        assert.equals(380, cuentaCombinada.saldo())
        assert.equals(80, cuentaDeGastosDeMantenimiento.saldo())
    }

    test "Gasto impacta saldo y monto de gastos correctamente" {
        casa.cambiarCuenta(cuentaCombinada)
        cuentaDeGastosDeMantenimiento.costoDeOperacion(20)
        cuentaCorriente.depositar(300)
        cuentaCombinada.depositar(100)
        casa.gasto(280)
        assert.equals(280, casa.montoTotalDeGastos())
        assert.equals(100, cuentaCombinada.saldo())
        assert.equals(0, cuentaDeGastosDeMantenimiento.saldo())
        assert.equals(100, cuentaCorriente.saldo())
    }

    test "Depositar monto pequeño en cuenta combinada lanza excepción" {
        casa.cambiarCuenta(cuentaCombinada)
        cuentaDeGastosDeMantenimiento.costoDeOperacion(20)
        cuentaCorriente.depositar(300)
        cuentaCombinada.depositar(100)
        casa.gasto(280)
        assert.throwsException({
            cuentaCombinada.depositar(10)
        })
    }

    test "Gasto excesivo en casa lanza excepción" {
        casa.cambiarCuenta(cuentaCombinada)
        cuentaDeGastosDeMantenimiento.costoDeOperacion(20)
        cuentaCorriente.depositar(300)
        cuentaCombinada.depositar(100)
        casa.gasto(280)
        assert.throwsException({
            casa.gasto(1000)
        })
    }
}

describe "Víveres y reparaciones en casa" {
    method initialize() {
        casa.cambiarCantidadDeViveres(30)
        casa.cambiarCuenta(cuentaCorriente)
        cuentaCorriente.depositar(2000)
    }

    test "Casa sin suficientes víveres luego de daño y reparación pendientes" {
        casa.seRompio(1000)
        assert.equals(false, casa.tieneViveresSuficientes())
        assert.equals(true, casa.hayQueHacerReparaciones())
        assert.equals(false, casa.estaEnOrden())
        assert.throwsException({
            casa.comprar(80, 2)
        })
    }

    test "Comprar víveres suficientes para ordenar casa sin reparaciones aún" {
        casa.seRompio(1000)
        casa.comprar(20, 2)
        assert.equals(true, casa.tieneViveresSuficientes())
        assert.equals(50, casa.viveres())
        assert.equals(false, casa.estaEnOrden())
        assert.equals(1960, cuentaCorriente.saldo())
        assert.equals(40, casa.montoTotalDeGastos())
    }

    test "Realizar reparación deja casa en orden y ajusta gastos y saldo" {
        casa.seRompio(1000)
        casa.comprar(20, 2)
        casa.realizarReparacion()
        assert.equals(false, casa.hayQueHacerReparaciones())
        assert.equals(true, casa.estaEnOrden())
        assert.equals(960, cuentaCorriente.saldo())
        assert.equals(1040, casa.montoTotalDeGastos())
    }
}







































































